# ══════════════════════════════════════════════════════════════════════════════
# Cloud Cost Optimizer — Environment Variables
# Copy this to .env and fill in production values before deploying
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=db
DB_USER=postgres
DB_PASSWORD=postgres123
DATABASE_URL=postgresql://postgres:postgres123@db:5432/cloudoptimizer

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis:6379,password=redis123
REDIS_PASSWORD=redis123

# ── JWT (CHANGE IN PRODUCTION — must be 32+ chars) ────────────────────────────
JWT_SECRET=SuperSecretJwtKeyChangeInProduction2024!
JWT_ISSUER=CloudCostOptimizer
JWT_AUDIENCE=CloudCostOptimizerUsers
JWT_EXPIRY_MINUTES=1440

# ── Service URLs (internal Docker network) ────────────────────────────────────
SCANNER_SERVICE_URL=http://scanner-service:8001
ANALYSIS_ENGINE_URL=http://analysis-engine:8002
SCHEDULER_SERVICE_URL=http://scheduler-service:8003

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Cloud Simulation ──────────────────────────────────────────────────────────
# Set to "false" to use real AWS/Azure SDK calls (requires real credentials)
SIMULATE_CLOUD=true

# ── Scheduler cron (default: every 6 hours) ───────────────────────────────────
SCAN_CRON_HOUR=*/6
SCAN_CRON_MINUTE=0

# ── AWS Credentials (optional — only needed if SIMULATE_CLOUD=false) ──────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# ── Azure Credentials (optional) ──────────────────────────────────────────────
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=
